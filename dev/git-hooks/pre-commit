#!/usr/bin/env bash
# Blocks commits with style errors on staged Lua lines (warnings are printed but don't block)
# Also blocks commits whose staged files fail the precommit tier of the headless tests (dev/run-tests.py --tier precommit, about 10 minutes)
# The tests only run when a staged file can change what the mod does
# Enabled with: git config core.hooksPath dev/git-hooks
# Skip once with: git commit --no-verify
set -e
root="$(git rev-parse --show-toplevel)"
python3 "$root/dev/style-check.py" --staged
if git diff --cached --name-only | grep -qE '\.lua$|^info\.json$|^locale/|^tests/'; then
    python3 "$root/dev/run-tests.py" --tier precommit --staged
fi
