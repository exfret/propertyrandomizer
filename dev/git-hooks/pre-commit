#!/usr/bin/env bash
# Blocks commits with style errors on staged Lua lines (warnings are printed but don't block)
# Also tests staged files against HEAD with matched settings/seeds, and compares each config's Lua instruction count (dev/counter-mod).
# A count more than 25% and at least 200 million instructions above HEAD's blocks the commit.
# The tests only run when a staged file can change what the mod does
# Enabled with: git config core.hooksPath dev/git-hooks
# Skip once with: git commit --no-verify
set -e
root="$(git rev-parse --show-toplevel)"
# The recolored duplicate graphics (dev/make-dupe-graphics.py) are the game's sheets: they ship in releases but never go in the public repo; .gitignore keeps them out, and this catches a forced git add
if git diff --cached --name-only | grep -q '^graphics/dupes/'; then
    echo "pre-commit: graphics/dupes/ is generated from the game's sprites and stays out of the repository; unstage it (git restore --staged graphics/dupes)" >&2
    exit 1
fi
python3 "$root/dev/review-player-text.py" --staged
python3 "$root/dev/style-check.py" --staged
python3 "$root/dev/check-localisation.py" --staged
# New dependency graph node types need the user's approval (dev/node-types.json)
python3 "$root/dev/node-types.py" --staged
# New progression choices must use established handlers; helpers cannot hide extra graph builds/sorts.
python3 "$root/dev/check-progression-architecture.py" --staged
if git diff --cached --name-only | grep -qE '\.lua$|^info\.json$|^locale/|^tests/|^dev/(run-tests\.py|timing_compare\.py|factorio_launch\.py|git-hooks/pre-commit)$'; then
    python3 "$root/tests/unit/dev/test-timing-comparison.py"
    python3 "$root/dev/run-tests.py" --tier precommit --staged --baseline-ref HEAD
fi
