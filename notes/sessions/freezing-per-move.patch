+check(picked["aquilo"] == 1, "the only version goes to the first move by name")
+check(picked["aquilo-exfret-2-copy"] == nil, "a move with no version left takes none")
+
+-- move_editing_research_of: a planet that doesn't freeze blames the move whose research edits have its copy number
+reset_data()
+freezing.last = {
+    map = {
+        aquilo = "fulgora-exfret-2-copy",
+        ["aquilo-exfret-3-copy"] = "vulcanus",
+    },
+    old_frozen = {},
+    tech_edits = {
+        {
+            tech = "heating-tower-exfret-2-copy",
+            move = "aquilo",
+        },
+        {
+            tech = "heating-tower",
+            move = "aquilo-exfret-3-copy",
+        },
+    },
+}
+check(freezing.move_editing_research_of(gutils.key("planet", "nauvis-exfret-2-copy")) == "aquilo", "a copy 2 blames the move that edited version 2")
+check(freezing.move_editing_research_of(gutils.key("planet", "gleba")) == "aquilo-exfret-3-copy", "an original blames the move that edited the originals")
+check(freezing.move_editing_research_of(gutils.key("planet", "gleba-exfret-3-copy")) == nil, "nothing edited version 3, so a copy 3 can't blame a move")
+check(freezing.move_editing_research_of(gutils.key("surface", "space-platform")) == "aquilo-exfret-3-copy", "a room that isn't a planet copy counts as number 1")
+
+-- revert_move: the move's planets and research go back, and the other move stays
+reset_data()
+data.raw.planet["aquilo"].entities_require_heating = true
+data.raw.planet["aquilo-exfret-3-copy"].entities_require_heating = true
+freezing.last = {
+    map = {
+        aquilo = "fulgora-exfret-2-copy",
+        ["aquilo-exfret-3-copy"] = "vulcanus",
+    },
+    old_frozen = {
+        aquilo = true,
+        ["aquilo-exfret-3-copy"] = true,
+        ["fulgora-exfret-2-copy"] = false,
+        vulcanus = false,
+    },
+    tech_edits = {
+        {
+            tech = "heating-tower-exfret-2-copy",
+            prerequisites = { "planet-discovery-gleba-exfret-2-copy" },
+            research_trigger = {
+                type = "mine-entity",
+                entities = { "copper-stromatolite" },
+            },
+            move = "aquilo",
+        },
+        {
+            tech = "heating-tower",
+            prerequisites = { "planet-discovery-gleba" },
+            research_trigger = {
+                type = "mine-entity",
+                entities = { "copper-stromatolite" },
+            },
+            move = "aquilo-exfret-3-copy",
+        },
+    },
+}
+-- The moves as freezing.execute would have left them
+data.raw.planet["aquilo"].entities_require_heating = nil
+data.raw.planet["aquilo-exfret-3-copy"].entities_require_heating = nil
+data.raw.planet["fulgora-exfret-2-copy"].entities_require_heating = true
+data.raw.planet["vulcanus"].entities_require_heating = true
+data.raw.technology["heating-tower-exfret-2-copy"].prerequisites = { "planet-discovery-fulgora-exfret-2-copy" }
+data.raw.technology["heating-tower-exfret-2-copy"].research_trigger.entities = { "big-fulgora-rock" }
+data.raw.technology["heating-tower"].prerequisites = { "planet-discovery-vulcanus" }
+data.raw.technology["heating-tower"].research_trigger.entities = { "big-volcanic-rock" }
+freezing.revert_move("aquilo")
+check(data.raw.planet["aquilo"].entities_require_heating == true, "the move's old planet freezes again")
+check(data.raw.planet["fulgora-exfret-2-copy"].entities_require_heating == nil, "the move's new planet is warm again")
+check(data.raw.technology["heating-tower-exfret-2-copy"].prerequisites[1] == "planet-discovery-gleba-exfret-2-copy", "the move's research gets its prerequisite back")
+check(data.raw.technology["heating-tower-exfret-2-copy"].research_trigger.entities[1] == "copper-stromatolite", "the move's research gets its trigger back")
+check(data.raw.planet["vulcanus"].entities_require_heating == true, "the other move's new planet still freezes")
+check(data.raw.technology["heating-tower"].prerequisites[1] == "planet-discovery-vulcanus", "the other move's research stays moved")
+check(freezing.last.map["aquilo"] == nil and freezing.last.map["aquilo-exfret-3-copy"] == "vulcanus", "only the other move is left in the map")
+check(#freezing.last.tech_edits == 1 and freezing.last.tech_edits[1].move == "aquilo-exfret-3-copy", "only the other move's research edits are left")
+
+-- net_moves: a move goes from the planet that stops freezing, past planets that freeze before and after
+-- Planet i gets planet order[i]'s freezing: Aquilo gets its copy 2's, Fulgora's copy 2 gets Aquilo's, Aquilo's copy 2 gets Gleba's (none) and Gleba gets Fulgora copy 2's (none)
+local planets = { "aquilo", "aquilo-exfret-2-copy", "fulgora-exfret-2-copy", "gleba" }
+local frozen = { true, true, false, false }
+local moves = freezing.net_moves(planets, frozen, { 2, 4, 1, 3 })
+check(moves["aquilo-exfret-2-copy"] == "fulgora-exfret-2-copy", "the move starts at Aquilo's copy 2, which stops freezing, not at Aquilo, which only passes freezing along")
+check(moves["aquilo"] == nil, "Aquilo freezes before and after, so no move starts there")
+local num_moves = 0
+for _, _ in pairs(moves) do
+    num_moves = num_moves + 1
+end
+check(num_moves == 1, "one planet stops freezing and one starts, so there's one move")
+
+-- net_moves: without planets passing freezing along, each frozen planet's freezing goes straight to a warm one
+moves = freezing.net_moves(planets, frozen, { 3, 4, 1, 2 })
+check(moves["aquilo"] == "fulgora-exfret-2-copy" and moves["aquilo-exfret-2-copy"] == "gleba", "two frozen planets give their freezing to two warm ones")
+
+-- net_moves with revert_move: putting the move back freezes the planet that lost its freezing, so the frozen count stays
+reset_data()
+data.raw.planet["aquilo"].entities_require_heating = true
+data.raw.planet["aquilo-exfret-2-copy"].entities_require_heating = true
+local order = { 2, 4, 1, 3 }
+local old_frozen = {}
+for i, name in pairs(planets) do
+    old_frozen[name] = frozen[i]
+end
+for i, name in pairs(planets) do
+    data.raw.planet[name].entities_require_heating = frozen[order[i]] or nil
+end
+freezing.last = {
+    map = freezing.net_moves(planets, frozen, order),
+    old_frozen = old_frozen,
+    tech_edits = {},
+}
+freezing.revert_move("aquilo-exfret-2-copy")
+local num_frozen = 0
+for _, name in pairs(planets) do
+    if data.raw.planet[name].entities_require_heating then
+        num_frozen = num_frozen + 1
+    end
+end
+check(num_frozen == 2, "putting the only move back leaves as many frozen planets as before the moves")
+check(data.raw.planet["aquilo-exfret-2-copy"].entities_require_heating == true and data.raw.planet["fulgora-exfret-2-copy"].entities_require_heating == nil, "Aquilo's copy 2 freezes again and Fulgora's copy 2 doesn't")
+
+print("test-freezing: " .. num_checks .. " checks passed")
