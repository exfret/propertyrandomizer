+-- Plain-Lua regression test for freezing moves with planet copies (randomizations/planetary/freezing.lua), not loaded by the mod
+-- Run from the mod root: lua randomizations/planetary/test-freezing.lua
+--
+-- Each move stands alone (user, 2026-10-01): it takes its own version of the heat source research (the originals, or the copies with one dupe number), a failure is blamed on one move, and that move goes back by itself.
+-- These pin down which version a move takes (freezing.pick_versions), which move a planet that doesn't freeze blames (freezing.move_editing_research_of) and what going back undoes (freezing.revert_move).
+
+-- Stand-ins for the Factorio environment
+function table.deepcopy(tbl)
+    if type(tbl) ~= "table" then
+        return tbl
+    end
+    local copy = {}
+    for k, v in pairs(tbl) do
+        copy[k] = table.deepcopy(v)
+    end
+    return copy
+end
+function log(msg) end
+serpent = {
+    block = tostring,
+    line = tostring,
+}
+settings = {
+    startup = {},
+}
+mods = {}
+-- Nothing here is random (the generator needs Factorio's bit32)
+package.loaded["lib/random/rng"] = {}
+
+local gutils = require("lib/graph/graph-utils")
+local freezing = require("randomizations/planetary/freezing")
+
+local num_checks = 0
+local function check(condition, message)
+    num_checks = num_checks + 1
+    if not condition then
+        error("FAILED: " .. message)
+    end
+end
+
+-- A planet and its copies with dupe numbers 2 and 3, named as lib/dupe-planets.lua names them
+local function add_family(planets, name)
+    planets[name] = {
+        name = name,
+    }
+    for number = 2, 3 do
+        local copy_name = name .. "-exfret-" .. number .. "-copy"
+        planets[copy_name] = {
+            name = copy_name,
+            orig_name = name,
+            dupe_number = number,
+        }
+    end
+end
+
+local function reset_data()
+    local planets = {}
+    for _, name in pairs({ "nauvis", "gleba", "fulgora", "vulcanus", "aquilo" }) do
+        add_family(planets, name)
+    end
+    data = {
+        raw = {
+            planet = planets,
+            technology = {
+                ["heating-tower"] = {
+                    name = "heating-tower",
+                    prerequisites = { "planet-discovery-gleba" },
+                    research_trigger = {
+                        type = "mine-entity",
+                        entities = { "copper-stromatolite" },
+                    },
+                },
+                ["heating-tower-exfret-2-copy"] = {
+                    name = "heating-tower-exfret-2-copy",
+                    dupe_number = 2,
+                    prerequisites = { "planet-discovery-gleba-exfret-2-copy" },
+                    research_trigger = {
+                        type = "mine-entity",
+                        entities = { "copper-stromatolite" },
+                    },
+                },
+                ["heating-tower-exfret-3-copy"] = {
+                    name = "heating-tower-exfret-3-copy",
+                    dupe_number = 3,
+                    prerequisites = { "planet-discovery-gleba-exfret-3-copy" },
+                    research_trigger = {
+                        type = "mine-entity",
+                        entities = { "copper-stromatolite" },
+                    },
+                },
+            },
+        },
+    }
+end
+
+local all_versions = {
+    [1] = { "heating-tower" },
+    [2] = { "heating-tower-exfret-2-copy" },
+    [3] = { "heating-tower-exfret-3-copy" },
+}
+
+-- pick_versions: the new planet's copy number first, keeping the research in that copy's tree
+reset_data()
+local picked = freezing.pick_versions({
+    aquilo = "fulgora-exfret-2-copy",
+    ["aquilo-exfret-3-copy"] = "fulgora-exfret-3-copy",
+}, all_versions)
+check(picked["aquilo"] == 2, "a move to a copy 2 takes version 2, not its old planet's version 1")
+check(picked["aquilo-exfret-3-copy"] == 3, "a move to a copy 3 takes version 3")
+
+-- pick_versions: a version is taken once; the second move to a copy 2 falls back to its old planet's number
+picked = freezing.pick_versions({
+    aquilo = "fulgora-exfret-2-copy",
+    ["aquilo-exfret-3-copy"] = "vulcanus-exfret-2-copy",
+}, all_versions)
+check(picked["aquilo"] == 2, "the first move by name takes the version both new planets have")
+check(picked["aquilo-exfret-3-copy"] == 3, "the second falls back to its old planet's version")
+
+-- pick_versions: when both rules are taken, the lowest version left
+picked = freezing.pick_versions({
+    aquilo = "gleba-exfret-3-copy",
+    ["aquilo-exfret-3-copy"] = "vulcanus-exfret-3-copy",
+}, all_versions)
+check(picked["aquilo"] == 3, "a move to Gleba's copy 3 takes version 3, Gleba copy 3's own")
+check(picked["aquilo-exfret-3-copy"] == 1, "with its new and old numbers taken, the lowest version left")
+
+-- pick_versions: without copies there's one version, which the first move by name takes, and the other takes none
+picked = freezing.pick_versions({
+    aquilo = "vulcanus",
+    ["aquilo-exfret-2-copy"] = "fulgora",
+}, {
+    [1] = { "heating-tower" },
